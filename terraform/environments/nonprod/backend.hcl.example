# Copy to backend.hcl (git-ignored) and fill in the bootstrap outputs:
#   terraform -chdir=../../bootstrap output state_bucket
#   terraform -chdir=../../bootstrap output lock_table
bucket         = "eks-platform-tfstate-123456789012"
key            = "nonprod/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "eks-platform-tfstate-lock"
encrypt        = true
